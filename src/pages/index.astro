---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Zap, Radio, TrendingDown, Layers, Settings, Shield, Activity, Cpu, Database, Search, Users, CheckCircle, Calendar, ArrowRight, MousePointer2 } from "lucide-astro";
---

<Layout>
  <Navbar />
  <main>

  <!-- HERO -->
  <!-- HERO -->
  <section class="relative bg-slate-900 pt-20 pb-12 overflow-hidden">
    <!-- Subtle Background Decor -->
    <div class="absolute inset-0 z-0 opacity-40">
      <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-blue-600/20 blur-[130px] rounded-full"></div>
      <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-blue-400/10 blur-[130px] rounded-full"></div>
    </div>

    <div class="max-w-screen-2xl mx-auto px-4 md:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-bold tracking-widest uppercase mb-6 backdrop-blur-sm">
          <div class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></div>
          <span data-i18n="home_hero_badge">Интегратор дроновых решений</span>
        </div>
        
        <h1 class="text-6xl md:text-8xl font-black text-white leading-[0.9] tracking-tighter uppercase mb-6" data-i18n-html="home_hero_h1">
          БПЛА<br />
          <span class="text-blue-500 italic">И ИИ</span><br />
          <span class="text-slate-400 font-light translate-x-2 inline-block text-4xl md:text-6xl">под вашу задачу</span>
        </h1>

        <p class="text-lg text-slate-300 leading-relaxed max-w-xl mb-10" data-i18n="home_hero_desc">
          Проектируем, поставляем и внедряем автономные дроновые системы с ИИ-аналитикой для промышленности, защиты природы и национальной безопасности.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <button data-popup="contact" class="px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-full transition-all shadow-lg shadow-blue-500/25 active:scale-95 flex items-center justify-center gap-2 group text-sm">
            <span data-i18n="home_hero_cta_demo">Запросить демо</span>
            <ArrowRight size={18} class="group-hover:translate-x-1 transition-transform" />
          </button>
          <a href="#solutions" class="px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-bold rounded-full transition-all border border-white/10 backdrop-blur-sm text-sm flex items-center justify-center" data-i18n="home_hero_cta_solutions">
            Наши решения
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section id="capabilities" class="py-24 bg-white relative overflow-hidden">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8">
      <div class="mb-16 reveal max-w-3xl">
        <span class="text-blue-600 font-bold uppercase tracking-[0.2em] text-xs" data-i18n="home_cap_label">Компетенции</span>
        <h2 class="text-4xl md:text-6xl font-black text-slate-900 mt-4 mb-6 uppercase tracking-tight" data-i18n-html="home_cap_title">ПОЛНЫЙ СТЕК <span class="text-blue-600">УСЛУГ</span></h2>
        <p class="text-slate-500 text-lg leading-relaxed" data-i18n="home_cap_desc">От анализа задачи до обучения персонала — весь проект под ключ.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal">
        <div class="p-10 rounded-[32px] bg-slate-50 border border-slate-100 transition-all hover:shadow-2xl hover:shadow-blue-500/10 hover:-translate-y-1 group">
          <div class="w-16 h-16 bg-blue-600 text-white rounded-2xl flex items-center justify-center mb-10 shadow-lg shadow-blue-500/30 group-hover:scale-110 transition-transform"><Layers size={32} /></div>
          <div class="text-blue-600 font-black text-5xl mb-4 opacity-10">01</div>
          <h3 class="text-xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_cap1_title">Анализ и проектирование</h3>
          <p class="text-slate-500 text-sm leading-relaxed" data-i18n="home_cap1_desc">Переводим операционную проблему в конкретное решение: тип БПЛА, количество, сенсоры, маршруты и архитектуру ПО.</p>
        </div>

        <div class="p-10 rounded-[32px] bg-slate-50 border border-slate-100 transition-all hover:shadow-2xl hover:shadow-blue-500/10 hover:-translate-y-1 group">
          <div class="w-16 h-16 bg-blue-600/10 text-blue-600 rounded-2xl flex items-center justify-center mb-10 group-hover:bg-blue-600 group-hover:text-white transition-all group-hover:shadow-lg group-hover:shadow-blue-500/30"><Settings size={32} /></div>
          <div class="text-blue-600 font-black text-5xl mb-4 opacity-10">02</div>
          <h3 class="text-xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_cap2_title">Подбор и кастомизация</h3>
          <p class="text-slate-500 text-sm leading-relaxed" data-i18n="home_cap2_desc">Находим оптимальную платформу на глобальном рынке ($3K–$100K). Дорабатываем камеры, датчики и ПО под задачу.</p>
        </div>

        <div class="p-10 rounded-[32px] bg-slate-50 border border-slate-100 transition-all hover:shadow-2xl hover:shadow-blue-500/10 hover:-translate-y-1 group">
          <div class="w-16 h-16 bg-blue-600/10 text-blue-600 rounded-2xl flex items-center justify-center mb-10 group-hover:bg-blue-600 group-hover:text-white transition-all group-hover:shadow-lg group-hover:shadow-blue-500/30"><Cpu size={32} /></div>
          <div class="text-blue-600 font-black text-5xl mb-4 opacity-10">03</div>
          <h3 class="text-xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_cap3_title">Разработка ПО и ИИ</h3>
          <p class="text-slate-500 text-sm leading-relaxed" data-i18n="home_cap3_desc">Дашборды реального времени, модели обнаружения аномалий, интеграция с ERP и внешними системами через API.</p>
        </div>

        <div class="p-10 rounded-[32px] bg-slate-50 border border-slate-100 transition-all hover:shadow-2xl hover:shadow-blue-500/10 hover:-translate-y-1 group">
          <div class="w-16 h-16 bg-blue-600/10 text-blue-600 rounded-2xl flex items-center justify-center mb-10 group-hover:bg-blue-600 group-hover:text-white transition-all group-hover:shadow-lg group-hover:shadow-blue-500/30"><Activity size={32} /></div>
          <div class="text-blue-600 font-black text-5xl mb-4 opacity-10">04</div>
          <h3 class="text-xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_cap4_title">Управление проектом</h3>
          <p class="text-slate-500 text-sm leading-relaxed" data-i18n="home_cap4_desc">Планируем и ведём проект от ТЗ до сдачи: сроки, команда, бюджет и коммуникация с заказчиком.</p>
        </div>

        <div class="p-10 rounded-[32px] bg-slate-50 border border-slate-100 transition-all hover:shadow-2xl hover:shadow-blue-500/10 hover:-translate-y-1 group">
          <div class="w-16 h-16 bg-blue-600/10 text-blue-600 rounded-2xl flex items-center justify-center mb-10 group-hover:bg-blue-600 group-hover:text-white transition-all group-hover:shadow-lg group-hover:shadow-blue-500/30"><Users size={32} /></div>
          <div class="text-blue-600 font-black text-5xl mb-4 opacity-10">05</div>
          <h3 class="text-xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_cap5_title">Подбор и обучение</h3>
          <p class="text-slate-500 text-sm leading-relaxed" data-i18n="home_cap5_desc">Нанимаем операторов и инженеров. Обучаем команду клиента для самостоятельной эксплуатации системы.</p>
        </div>

        <div class="p-10 rounded-[32px] bg-slate-50 border border-slate-100 transition-all hover:shadow-2xl hover:shadow-blue-500/10 hover:-translate-y-1 group">
          <div class="w-16 h-16 bg-blue-600/10 text-blue-600 rounded-2xl flex items-center justify-center mb-10 group-hover:bg-blue-600 group-hover:text-white transition-all group-hover:shadow-lg group-hover:shadow-blue-500/30"><Database size={32} /></div>
          <div class="text-blue-600 font-black text-5xl mb-4 opacity-10">06</div>
          <h3 class="text-xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_cap6_title">Логистика и поставка</h3>
          <p class="text-slate-500 text-sm leading-relaxed" data-i18n="home_cap6_desc">Импорт, таможня, транспортировка и доставка всего оборудования на объект в любую точку мира.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SOLUTIONS -->
  <section id="solutions" class="py-24 bg-slate-50 relative overflow-hidden">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8">
      <div class="mb-16 reveal max-w-3xl">
        <span class="text-blue-600 font-bold uppercase tracking-[0.2em] text-xs" data-i18n="home_sol_label">Решения</span>
        <h2 class="text-4xl md:text-6xl font-black text-slate-900 mt-4 mb-6 uppercase tracking-tight" data-i18n-html="home_sol_title">ОТРАСЛЕВЫЕ <span class="text-blue-600">СИСТЕМЫ</span></h2>
        <p class="text-slate-500 text-lg leading-relaxed" data-i18n="home_sol_desc">Готовые и кастомные решения для четырёх ключевых направлений.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 reveal">
        <!-- Wildfire -->
        <div class="group relative overflow-hidden rounded-[40px] bg-white border border-slate-200 p-10 transition-all hover:shadow-2xl hover:border-blue-500/20">
          <div class="absolute top-0 right-0 w-64 h-64 bg-blue-50 rounded-full -mr-32 -mt-32 transition-transform group-hover:scale-110"></div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-8">
              <span class="px-4 py-1 rounded-full bg-blue-600 text-white text-[10px] font-bold tracking-widest uppercase" data-i18n="home_sol_wf_badge">Готовое решение</span>
              <div class="w-12 h-12 bg-blue-600/10 text-blue-600 rounded-xl flex items-center justify-center"><Activity size={24} /></div>
            </div>
            <h3 class="text-3xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_sol_wf_title">Мониторинг лесных пожаров</h3>
            <p class="text-slate-500 text-sm leading-relaxed mb-8" data-i18n="home_sol_wf_desc">Автономные БПЛА с тепловизорами и ИИ-обнаружением огня. Раннее выявление очагов, трекинг фронта, координация реагирования в реальном времени.</p>
            <div class="flex flex-wrap gap-2 mb-8">
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_wf_tag1">Обнаружение за минуты</span>
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_wf_tag2">BVLOS + меш-связь</span>
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_wf_tag3">Edge AI</span>
            </div>
            <a href="/wildfire-solution" class="inline-flex items-center gap-2 text-blue-600 font-bold text-sm tracking-widest uppercase hover:gap-3 transition-all">
              <span data-i18n="home_sol_wf_link">Подробнее</span> <ArrowRight size={16} />
            </a>
          </div>
        </div>

        <!-- Pipeline -->
        <div class="group relative overflow-hidden rounded-[40px] bg-white border border-slate-200 p-10 transition-all hover:shadow-2xl hover:border-blue-500/20">
          <div class="absolute top-0 right-0 w-64 h-64 bg-blue-50 rounded-full -mr-32 -mt-32 transition-transform group-hover:scale-110"></div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-8">
              <span class="px-4 py-1 rounded-full bg-slate-100 text-slate-500 text-[10px] font-bold tracking-widest uppercase border border-slate-200" data-i18n="home_sol_pipe_badge">Под заказ</span>
              <div class="w-12 h-12 bg-blue-600/10 text-blue-600 rounded-xl flex items-center justify-center"><Search size={24} /></div>
            </div>
            <h3 class="text-3xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_sol_pipe_title">Инспекция трубопроводов</h3>
            <p class="text-slate-500 text-sm leading-relaxed mb-8" data-i18n="home_sol_pipe_desc">Обнаружение утечек, коррозии и структурных аномалий. Данные с дрона — напрямую в ERP. Снижение затрат на инспекцию до 70%.</p>
            <div class="flex flex-wrap gap-2 mb-8">
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_pipe_tag1">Детектор метана</span>
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_pipe_tag2">Edge AI</span>
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_pipe_tag3">BVLOS полёты</span>
            </div>
            <a href="/pipeline-solution" class="inline-flex items-center gap-2 text-blue-600 font-bold text-sm tracking-widest uppercase hover:gap-3 transition-all">
              <span data-i18n="home_sol_pipe_link">Подробнее</span> <ArrowRight size={16} />
            </a>
          </div>
        </div>

        <!-- Substation -->
        <div class="group relative overflow-hidden rounded-[40px] bg-white border border-slate-200 p-10 transition-all hover:shadow-2xl hover:border-blue-500/20">
          <div class="absolute top-0 right-0 w-64 h-64 bg-blue-50 rounded-full -mr-32 -mt-32 transition-transform group-hover:scale-110"></div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-8">
              <span class="px-4 py-1 rounded-full bg-slate-100 text-slate-500 text-[10px] font-bold tracking-widest uppercase border border-slate-200" data-i18n="home_sol_grid_badge">Под заказ</span>
              <div class="w-12 h-12 bg-blue-600/10 text-blue-600 rounded-xl flex items-center justify-center"><Radio size={24} /></div>
            </div>
            <h3 class="text-3xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_sol_grid_title">Инспекция подстанций</h3>
            <p class="text-slate-500 text-sm leading-relaxed mb-8" data-i18n="home_sol_grid_desc">Автономный тепловизионный осмотр энергооборудования. Предиктивное обслуживание вместо реактивного ремонта. Работа в зонах ЭМИ.</p>
            <div class="flex flex-wrap gap-2 mb-8">
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_grid_tag1">Радиометрика</span>
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_grid_tag2">Защита от ЭМИ</span>
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_grid_tag3">Повторяемые маршруты</span>
            </div>
            <a href="/grid-solution" class="inline-flex items-center gap-2 text-blue-600 font-bold text-sm tracking-widest uppercase hover:gap-3 transition-all">
              <span data-i18n="home_sol_grid_link">Подробнее</span> <ArrowRight size={16} />
            </a>
          </div>
        </div>

        <!-- Border -->
        <div class="group relative overflow-hidden rounded-[40px] bg-white border border-slate-200 p-10 transition-all hover:shadow-2xl hover:border-blue-500/20">
          <div class="absolute top-0 right-0 w-64 h-64 bg-blue-50 rounded-full -mr-32 -mt-32 transition-transform group-hover:scale-110"></div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-8">
              <span class="px-4 py-1 rounded-full bg-slate-100 text-slate-500 text-[10px] font-bold tracking-widest uppercase border border-slate-200" data-i18n="home_sol_brd_badge">Под заказ</span>
              <div class="w-12 h-12 bg-blue-600/10 text-blue-600 rounded-xl flex items-center justify-center"><Shield size={24} /></div>
            </div>
            <h3 class="text-3xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_sol_brd_title">Охрана границ</h3>
            <p class="text-slate-500 text-sm leading-relaxed mb-8" data-i18n="home_sol_brd_desc">Автономное патрулирование периметра 24/7. ИИ-классификация целей, трекинг в сложном рельефе, военное шифрование, интеграция с РЛС.</p>
            <div class="flex flex-wrap gap-2 mb-8">
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_brd_tag1">Тепловизор 24/7</span>
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_brd_tag2">ИИ-распознавание</span>
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-lg uppercase" data-i18n="home_sol_brd_tag3">До 8 ч. полёта</span>
            </div>
            <a href="/border-solution" class="inline-flex items-center gap-2 text-blue-600 font-bold text-sm tracking-widest uppercase hover:gap-3 transition-all">
              <span data-i18n="home_sol_brd_link">Подробнее</span> <ArrowRight size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PARTNERS -->
  <section id="partners" class="py-24 bg-white relative overflow-hidden">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8">
      <div class="mb-16 reveal max-w-3xl">
        <span class="text-blue-600 font-bold uppercase tracking-[0.2em] text-xs" data-i18n="home_par_label">Партнёрам</span>
        <h2 class="text-4xl md:text-6xl font-black text-slate-900 mt-4 mb-6 uppercase tracking-tight" data-i18n-html="home_par_title">РАБОТАЕМ <span class="text-blue-600">С ПАРТНЁРАМИ</span></h2>
        <p class="text-slate-500 text-lg leading-relaxed" data-i18n="home_par_desc">У вас есть доступ к клиентам или контрактам — у нас есть экспертиза. Три формата сотрудничества.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 reveal">
        <!-- Partner Card 1 -->
        <div class="p-10 rounded-[40px] bg-slate-50 border border-slate-100 transition-all hover:shadow-2xl hover:-translate-y-1 relative group">
          <div class="absolute top-8 right-8 text-7xl font-black text-blue-600/5 group-hover:text-blue-600/10 transition-colors">1</div>
          <div class="w-16 h-16 bg-blue-600/10 text-blue-600 rounded-2xl flex items-center justify-center mb-10 group-hover:bg-blue-600 group-hover:text-white transition-all"><Users size={32} /></div>
          <h3 class="text-xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_par1_title">Реферальный партнёр</h3>
          <p class="text-slate-500 text-sm leading-relaxed mb-8" data-i18n="home_par1_desc">Вы находите клиента или передаёте лид — мы берём всё остальное: проектирование, поставку, внедрение и поддержку.</p>
          <div class="pt-6 border-t border-slate-200 text-[11px] font-bold text-blue-600 uppercase tracking-widest leading-relaxed" data-i18n="home_par1_foot">
            Вы фокусируетесь на отношениях — мы берём техчасть
          </div>
        </div>

        <!-- Partner Card 2 -->
        <div class="p-10 rounded-[40px] bg-slate-50 border border-slate-100 transition-all hover:shadow-2xl hover:-translate-y-1 relative group">
          <div class="absolute top-8 right-8 text-7xl font-black text-blue-600/5 group-hover:text-blue-600/10 transition-colors">2</div>
          <div class="w-16 h-16 bg-blue-600/10 text-blue-600 rounded-2xl flex items-center justify-center mb-10 group-hover:bg-blue-600 group-hover:text-white transition-all"><Layers size={32} /></div>
          <h3 class="text-xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_par2_title">Субподрядчик</h3>
          <p class="text-slate-500 text-sm leading-relaxed mb-8" data-i18n="home_par2_desc">У вас есть действующий контракт с дрон-компонентом? Мы полностью закрываем эту часть. Вы остаётесь генеральным подрядчиком.</p>
          <div class="pt-6 border-t border-slate-200 text-[11px] font-bold text-blue-600 uppercase tracking-widest leading-relaxed" data-i18n="home_par2_foot">
            Расширьте свои возможности без найма
          </div>
        </div>

        <!-- Partner Card 3 -->
        <div class="p-10 rounded-[40px] bg-slate-50 border border-slate-100 transition-all hover:shadow-2xl hover:-translate-y-1 relative group">
          <div class="absolute top-8 right-8 text-7xl font-black text-blue-600/5 group-hover:text-blue-600/10 transition-colors">3</div>
          <div class="w-16 h-16 bg-blue-600/10 text-blue-600 rounded-2xl flex items-center justify-center mb-10 group-hover:bg-blue-600 group-hover:text-white transition-all"><Zap size={32} /></div>
          <h3 class="text-xl font-black text-slate-900 mb-4 uppercase tracking-tight" data-i18n="home_par3_title">Совместная продажа</h3>
          <p class="text-slate-500 text-sm leading-relaxed mb-8" data-i18n="home_par3_desc">Вы открываете двери, мы предоставляем техническое решение и ROI-расчёт. Совместный питч — совместный доход.</p>
          <div class="pt-6 border-t border-slate-200 text-[11px] font-bold text-blue-600 uppercase tracking-widest leading-relaxed" data-i18n="home_par3_foot">
            Вместе закрываем более крупные сделки
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
